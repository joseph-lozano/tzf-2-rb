#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "json"
require "tmpdir"
require "rubygems/package"

def rss_kb
  `ps -o rss= -p #{Process.pid}`.to_i
end

before_rss = rss_kb
t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
require "tzf2"
TZF.tz_name(40.7128, -74.0060)
init_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0) * 1000).round(2)
after_rss = rss_kb

warmup = [
  [40.7128, -74.0060],
  [-48.876667, -123.393333],
  [0.0, 0.0],
  [0.0, 180.0]
]
200.times { |i| lat, lng = warmup[i % warmup.length]; TZF.tz_name(lat, lng) }

n = 20_000
t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
n.times { |i| lat, lng = warmup[i % warmup.length]; TZF.tz_name(lat, lng) }
elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t1
ns_per_query = ((elapsed / n) * 1_000_000_000).round

bundle = Dir["lib/tzf2/tzf2.{bundle,so}"].first
bundle_bytes = bundle ? File.size(bundle) : nil

gem_bytes = Dir.mktmpdir do |dir|
  spec = Gem::Specification.load(File.expand_path("../tzf2.gemspec", __dir__))
  builder = Gem::Package.new(File.join(dir, spec.file_name))
  builder.spec = spec
  builder.build
  File.size(File.join(dir, spec.file_name))
end

report = {
  "ruby" => RUBY_DESCRIPTION,
  "engine_version" => TZF.engine_version,
  "data_version" => TZF.data_version,
  "timezone_count" => TZF.timezone_names.length,
  "init_ms" => init_ms,
  "query_ns" => ns_per_query,
  "rss_kb_before_load" => before_rss,
  "rss_kb_after_first_query" => after_rss,
  "rss_kb_delta" => after_rss - before_rss,
  "native_bundle_bytes" => bundle_bytes,
  "gem_package_bytes" => gem_bytes
}

puts JSON.pretty_generate(report)
File.write("tmp/measure.json", "#{JSON.pretty_generate(report)}\n")
