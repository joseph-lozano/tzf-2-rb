#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "json"
require "tzf2"
require_relative "../spec/support/locations"

points = SpecLocations.all.transform_values { |point| [point.fetch("lat"), point.fetch("lng")] }

report = {
  "engine_version" => TZF.engine_version,
  "data_version" => TZF.data_version,
  "timezone_count" => TZF.timezone_names.length,
  "points" => points.to_h do |name, (lat, lng)|
    begin
      [
        name,
        {
          "lat" => lat,
          "lng" => lng,
          "tz_name" => TZF.tz_name(lat, lng),
          "tz_names" => TZF.tz_names(lat, lng)
        }
      ]
    rescue TZF::Error => e
      [
        name,
        {
          "lat" => lat,
          "lng" => lng,
          "error" => e.class.name,
          "message" => e.message
        }
      ]
    end
  end
}

puts JSON.pretty_generate(report)
